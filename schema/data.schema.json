{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edwardtay.github.io/awesome-reverse-engineering/schema/data.schema.json",
  "title": "Awesome Reverse Engineering dataset",
  "description": "Editorial source of truth. README.md, the website, llms.txt, report.json and the JSON API are generated from this file.",
  "type": "object",
  "required": ["categories", "entries"],
  "additionalProperties": true,
  "properties": {
    "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "graveyard": {
      "type": "array",
      "items": { "$ref": "#/$defs/graveyard" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "title", "intro"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 },
        "extra": { "type": "string", "description": "Optional Markdown appended after the category table." }
      }
    },
    "entry": {
      "type": "object",
      "required": ["c", "n", "u", "cost", "d"],
      "additionalProperties": false,
      "properties": {
        "c": { "type": "string", "description": "Category id." },
        "n": { "type": "string", "minLength": 1 },
        "u": { "type": "string", "pattern": "^https://\\S+$" },
        "cost": { "type": "string", "minLength": 1 },
        "d": {
          "type": "string",
          "minLength": 1,
          "pattern": "[.)]$",
          "description": "One sentence saying when the tool is the right choice. Must end with a period."
        },
        "f": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["runs", "cloud", "impersonated"] },
          "description": "Safety flags. runs = executes code; cloud = sends code to a third party; impersonated = lookalike sites reported."
        },
        "r": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$",
          "description": "GitHub owner/repo when it differs from the URL."
        },
        "m": { "type": "string", "description": "Declared maintenance note, shown with a warning." },
        "t": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "Optional extra tags. Most tags are derived from the name, description and category."
        },
        "p": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "Optional host platforms, for example windows, macos, linux, android, ios."
        },
        "lic": { "type": "string", "description": "Optional SPDX licence identifier for the tool itself." },
        "i": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional install hints, for example { brew, pip, go, winget }."
        },
        "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "pattern": "^https://\\S+$" }
            }
          }
        }
      }
    },
    "graveyard": {
      "type": "object",
      "required": ["n", "u", "why", "instead"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "string", "minLength": 1 },
        "u": { "type": "string", "pattern": "^https://\\S+$" },
        "why": { "type": "string", "minLength": 1 },
        "instead": { "type": "string", "minLength": 1 }
      }
    }
  }
}
